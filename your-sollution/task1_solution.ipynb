import os
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.model_selection import train_test_split
from sklearn.impute import SimpleImputer
from sklearn.preprocessing import StandardScaler
from sklearn.svm import SVC
from sklearn.neighbors import KNeighborsClassifier
from sklearn.metrics import (accuracy_score, recall_score, precision_score, 
                             f1_score, roc_auc_score, confusion_matrix, 
                             roc_curve, classification_report)
from sklearn.decomposition import PCA

TRAIN_PATH = 'train.csv'
TEST_PATH = 'test_features.csv'


train_df = pd.read_csv(TRAIN_PATH)
test_df = pd.read_csv(TEST_PATH)

target_cols = ['prediction', 'Статус_глюкозы', 'Доклинический_риск']
feature_cols = [c for c in train_df.columns if c not in target_cols and c != 'patient_id']

X = train_df[feature_cols]
y_pred = train_df['prediction']

plt.figure(figsize=(6,4))
sns.countplot(x=y_pred)
plt.title("Баланс классов (prediction)")
plt.show()

temp_imputer = SimpleImputer(strategy='median')
temp_scaler = StandardScaler()
X_temp = temp_scaler.fit_transform(temp_imputer.fit_transform(X))

pca = PCA(n_components=2)
X_pca = pca.fit_transform(X_temp)
plt.figure(figsize=(8,6))
sns.scatterplot(x=X_pca[:,0], y=X_pca[:,1], hue=y_pred, alpha=0.6)
plt.title("PCA: Проекция признаков (2 компоненты)")
plt.xlabel("PC1")
plt.ylabel("PC2")
plt.show()


X_train, X_val, y_train, y_val = train_test_split(
    X, y_pred, test_size=0.2, stratify=y_pred, random_state=42
)


imputer = SimpleImputer(strategy='median')
scaler = StandardScaler()

X_train_imp = imputer.fit_transform(X_train)
X_train_scaled = scaler.fit_transform(X_train_imp)

X_val_imp = imputer.transform(X_val)
X_val_scaled = scaler.transform(X_val_imp)

svm_clf = SVC(probability=True, class_weight='balanced', random_state=42)
svm_clf.fit(X_train_scaled, y_train)


y_val_pred = svm_clf.predict(X_val_scaled)
y_val_proba = svm_clf.predict_proba(X_val_scaled)[:, 1]


acc = accuracy_score(y_val, y_val_pred)
rec = recall_score(y_val, y_val_pred)
prec = precision_score(y_val, y_val_pred)
f1 = f1_score(y_val, y_val_pred)
roc_auc = roc_auc_score(y_val, y_val_proba)

cm = confusion_matrix(y_val, y_val_pred)
tn, fp, fn, tp = cm.ravel()
specificity = tn / (tn + fp)

print(f"Accuracy:    {acc:.4f}")
print(f"Recall:      {rec:.4f}")
print(f"Specificity: {specificity:.4f}")
print(f"Precision:   {prec:.4f}")
print(f"F1 Score:    {f1:.4f}")
print(f"ROC-AUC:     {roc_auc:.4f}")


plt.figure(figsize=(5,4))
sns.heatmap(cm, annot=True, fmt='d', cmap='Blues')
plt.title("Confusion Matrix (Validation)")
plt.xlabel("Predicted")
plt.ylabel("Actual")
plt.show()


fpr, tpr, _ = roc_curve(y_val, y_val_proba)
plt.figure(figsize=(6,5))
plt.plot(fpr, tpr, label=f'SVM (AUC = {roc_auc:.3f})')
plt.plot([0, 1], [0, 1], 'k--')
plt.xlabel('False Positive Rate')
plt.ylabel('True Positive Rate')
plt.title('ROC-Curve')
plt.legend(loc='lower right')
plt.show()


glucose_col = [c for c in X.columns if 'Глюкоза_натощак_ммоль_л' in c][0]
glucose_idx = list(X.columns).index(glucose_col)


borderline_mask_val = (X_val[glucose_col] >= 5.4) & (X_val[glucose_col] <= 6.5)
X_val_borderline = X_val_scaled[borderline_mask_val]
y_val_borderline = y_val[borderline_mask_val]

if len(X_val_borderline) > 0:
    fuzzy_knn = KNeighborsClassifier(n_neighbors=5, weights='distance')
    fuzzy_knn.fit(X_train_scaled, y_train)
    
    membership_degrees = fuzzy_knn.predict_proba(X_val_borderline)
    risk_scores = membership_degrees[:, 1]
    
  
    uncertainty = 1 - np.max(membership_degrees, axis=1)
    
    plt.figure(figsize=(8,4))
    plt.hist(uncertainty, bins=20, color='purple', alpha=0.7)
    plt.title("Распределение неопределенности в пограничной группе (Глюкоза 5.4-6.5)")
    plt.xlabel("Степень неопределенности")
    plt.ylabel("Количество пациентов")
    plt.show()
    
    print(f"Найдено {len(X_val_borderline)} пациентов в пограничной зоне.")
    print(f"Средняя неопределенность: {uncertainty.mean():.4f}")
else:
    print("В валидационной выборке нет пациентов с таким уровнем глюкозы.")


X_test = test_df[feature_cols]

X_test_imp = imputer.transform(X_test)
X_test_scaled = scaler.transform(X_test_imp)

test_predictions = svm_clf.predict(X_test_scaled)

submission = pd.DataFrame({
    'patient_id': test_df['patient_id'],
    'prediction': test_predictions
})
submission.to_csv(OUTPUT_PATH, index=False)
